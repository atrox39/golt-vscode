{
  "name": "golt-vscode",
  "displayName": "Golt",
  "icon": "images/icon.jpg",
  "description": "Official Golt Runtime support for VS Code",
  "version": "1.0.5",
  "repository": {
    "type": "git",
    "url": "https://github.com/atrox39/golt-vscode.git"
  },
  "publisher": "Aztekode",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Other"
  ],
  "keywords": [
    "golt",
    "runtime",
    "typescript",
    "backend",
    "aztekode"
  ],
  "activationEvents": [
    "workspaceContains:golt.json",
    "onCommand:golt.enableWorkspace",
    "onCommand:golt.disableWorkspace"
  ],
  "contributes": {
    "commands": [
      {
        "command": "golt.enableWorkspace",
        "title": "Golt: Enable Workspace"
      },
      {
        "command": "golt.disableWorkspace",
        "title": "Golt: Disable Workspace"
      }
    ]
  },
  "main": "./dist/extension.js",
  "scripts": {
    "vscode:prepublish": "pnpm run package",
    "compile": "pnpm run check-types && pnpm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "pnpm run check-types && pnpm run lint && node esbuild.js --production",
    "vsix": "pnpm exec vsce package --no-dependencies",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "pnpm run compile-tests && pnpm run compile && pnpm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.90.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.27.3",
    "eslint": "^9.39.3",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  },
  "files": [
    "dist",
    "resources",
    "images",
    "package.json",
    "README.md",
    "LICENSE.txt"
  ]
}